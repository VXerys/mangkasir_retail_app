# Salin berkas ini menjadi `.env`, lalu isi dengan nilai proyek Supabase Anda.
#
#   cp .env.example .env
#
# Nilainya ada di dashboard Supabase → Project Settings → API.
# `.env` sudah masuk .gitignore dan tidak boleh di-commit.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
